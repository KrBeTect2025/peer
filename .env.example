# Address browsers use to reach coturn.
#   LAN only:  your PC's LAN IP (ipconfig)   e.g. 192.168.1.20
#   Internet:  your public IP (whatismyip)   + router port forwards
TURN_HOST=192.168.1.20
# Address coturn puts in its relay candidates (same value as TURN_HOST)
EXTERNAL_IP=192.168.1.20
TURN_USER=webrtc
TURN_PASS=change-me
