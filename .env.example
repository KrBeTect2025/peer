# Metered TURN (free 20 GB/month at metered.ca): relays the file when the two browsers can't connect directly.
# Without it, only direct connections work (STUN only).
METERED_TURN_URL=https://<yourapp>.metered.live/api/v1/turn/credentials?apiKey=<key>

# Redis that tracks the codes. Defaults to redis://localhost:6379/0 (docker compose sets it for you).
# In production use a hosted one, e.g. Upstash: rediss://default:<password>@<host>.upstash.io:6379
# REDIS_URL=

# How long a code stays valid, in seconds (default 3600)
# CODE_TTL=3600
